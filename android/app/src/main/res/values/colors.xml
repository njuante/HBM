<?xml version="1.0" encoding="utf-8"?>
<!--
  Los colores que `styles.xml` referencia. Sin este fichero AAPT falla con
  «resource color/colorPrimary not found» y no se llega a generar ningún APK.

  Los valores son los de la app: tinta cálida de fondo (--stone-950) y ámbar
  quemado como acento (--amber-600), definidos en src/app/globals.css.
-->
<resources>
    <color name="colorPrimary">#0a0a0b</color>
    <color name="colorPrimaryDark">#0a0a0b</color>
    <color name="colorAccent">#a85b22</color>
</resources>
